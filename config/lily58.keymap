#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                            &kp N6   &kp N7    &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                             &kp Y    &kp U     &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D     &kp F     &kp G                             &kp H    &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V     &kp B    &kp PSCRN       &kp RET  &kp N    &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &kp SPC  &mo 1           &mo 2    &kp SPC  &mo 4     &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp F1  &kp F2    &kp F3  &kp F4    &kp F5      &kp F6                             &kp F7     &kp F8     &kp F9       &kp F10   &kp F11   &kp F12
&trans  &trans    &trans  &trans    &trans      &trans                             &trans     &kp LBRC   &kp RBRC     &kp LBKT  &kp RBKT  &trans
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT                          &kp CARET  &kp LPAR   &kp RPAR     &kp KMLT  &kp AMPS  &kp TILDE
&trans  &trans    &trans  &trans    &trans      &trans      &trans         &trans  &kp BSPC   &kp KPLS   &kp EQUAL    &trans    &trans    &kp PIPE
                          &trans    &trans      &trans      &trans         &mo 3   &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans   &trans     &trans     &trans     &trans    &trans
&trans  &trans  &kp N7  &kp N8  &kp N9  &trans                    &trans   &kp PGUP   &kp UP     &kp PGDN   &kp HOME  &trans
&trans  &kp N0  &kp N4  &kp N5  &kp N6  &trans                    &trans   &kp LEFT   &kp DOWN   &kp RIGHT  &kp END   &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans  &trans    &trans  &kp DEL  &kp GRAVE  &kp TILDE  &trans     &trans    &kp BSLH
                        &trans  &trans  &trans  &mo 3     &trans  &trans   &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };


        extra_layer {
            display-name = "Extra";
            bindings = <
&kp F13   &kp F14    &kp F15    &kp F16    &kp F17    &kp F18                         &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp CAPS  &trans     &trans     &trans     &trans     &trans                          &trans      &trans        &trans        &trans        &trans        &trans
&trans    &kp LG(N1) &kp LG(N2) &kp LG(N3) &kp LG(N4) &kp LG(N5)                      &kp LG(N6)  &kp LG(N7)    &kp LG(N8)    &kp LG(N9)    &kp LG(N0)    &trans
&trans    &trans     &trans     &trans     &trans     &trans     &trans    &trans     &trans      &trans        &trans        &trans        &trans        &trans
                                &trans     &trans     &trans     &trans    &trans     &trans      &trans        &trans
            >;
        };

        alt_gr {
            display-name = "AltGR";
            bindings = <
&trans  &trans     &trans  &trans     &trans     &trans                    &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans     &trans  &kp RA(E)  &trans     &trans                    &trans     &kp RA(U)  &kp RA(I)  &kp RA(O)  &trans  &trans
&trans  &kp RA(A)  &trans  &trans     &trans     &trans                    &trans     &trans     &trans     &trans     &trans  &kp RA(LS(SQT))
&trans  &trans     &trans  &kp LG(C)  &kp LG(V)  &trans  &trans    &trans  &kp RA(N)  &trans     &trans     &trans     &trans  &trans
                                      &trans     &trans  &trans    &trans  &trans     &trans     &trans     &trans
            >;
        };
    };
};

